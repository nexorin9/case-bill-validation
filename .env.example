# =====================================================================
# 病案结算清单核验系统 · 环境变量样例
# 复制本文件为 .env 后按需填写真实值；.env 不应进入版本控制。
# 所有凭据必须从环境变量读取，业务层零硬编码。
# =====================================================================

# ----- 模型网关（OpenAI-compatible；本项目作为 LLM 语义层） -----
MODEL_GATEWAY_BASE_URL=https://api.openai.com/v1
MODEL_GATEWAY_API_KEY=sk-replace-me
MODEL_GATEWAY_MODEL=gpt-4o-mini
MODEL_GATEWAY_TIMEOUT=30

# ----- 病案系统回写（HTTP POST） -----
CASE_SYSTEM_WRITE_URL=https://case-system.example.internal/api/field-note
CASE_SYSTEM_WRITE_TOKEN=replace-me-with-real-token

# ----- HIS 出院小结拉取（可选 webhook 上传之外的备用入口） -----
HIS_DISCHARGE_URL=https://his.example.internal/api/discharge
HIS_DISCHARGE_TOKEN=replace-me

# ----- 审计与持久化 -----
AUDIT_LOG_DIR=./logs/audit
BILLING_DB_PATH=./billing_fields.db
EXPORT_DIR=./exports

# ----- 应用运行时 -----
APP_HOST=127.0.0.1
APP_PORT=8000